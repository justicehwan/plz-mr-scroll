{
  "name": "plz-mr-scroll",
  "version": "0.3.0",
  "description": "Don't push me plz, Mr. Scroll. Keeps your layout still when a scrollbar appears.",
  "keywords": [
    "scrollbar",
    "layout-shift",
    "scrollbar-gutter",
    "overlay-scrollbar",
    "react"
  ],
  "license": "MIT",
  "author": "Justicehwan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justicehwan/plz-mr-scroll.git"
  },
  "homepage": "https://github.com/justicehwan/plz-mr-scroll#readme",
  "bugs": {
    "url": "https://github.com/justicehwan/plz-mr-scroll/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "vite",
    "build:demo": "vite build --base=/plz-mr-scroll/ && node -e \"require('fs').copyFileSync('dist-demo/demo.html','dist-demo/index.html')\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && playwright test",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
